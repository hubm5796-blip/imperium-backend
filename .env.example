# ImperiumMC Backend Configuration

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=https://imperiummc.net/auth/callback
DISCORD_BOT_TOKEN=your_bot_token_here

# JWT (generate a random 32+ character string)
JWT_SECRET=change_me_to_a_random_string

# Database (same PostgreSQL as the game server)
DATABASE_URL=postgresql://user:password@localhost:5432/imperiummc

# Redis (same Redis as the plugin's command bus)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Plugin HMAC secret (shared with the plugin). The plugin prefers the
# IMPERIUMMC_HMAC_SECRET env var, falling back to webpanel.hmac-secret in config.yml.
# Generate with: openssl rand -hex 32   (≥32 bytes). MUST match on both sides.
# Rotate the old leaked value (ImperiumMC_SuperSecret_...) — it was committed.
WEBPANEL_HMAC_SECRET=generate_a_32_byte_random_hex_secret

# Bot shared secret. The Discord bot sends this in the `X-Bot-Token` header to
# authenticate bot-only endpoints (/link/confirm, DELETE /link,
# /player/profile with ?uuid= or ?discord_id=). Generate with:
#   openssl rand -hex 32   (≥32 bytes). MUST match BACKEND_API_TOKEN on the bot.
BOT_API_TOKEN=dev_bot_token_change_me

# Per-site vote callback keys for POST /api/vote/:site — comma-separated
# `site:key` pairs, e.g. "planetminecraft:s3cretKey1,minecraftservers:otherKey2".
# Each vote site sends its key in the X-Vote-Key header. In production set via
# `wrangler secret put VOTE_CALLBACK_KEYS`. Leave unset to disable vote callbacks.
VOTE_CALLBACK_KEYS=

# Server
PORT=3001
NODE_ENV=production

# CORS origins (comma-separated)
CORS_ORIGINS=https://imperiummc.net,https://www.imperiummc.net

# Discord bot auto-role (role ID to assign on successful link, or leave blank)
DISCORD_LINKED_ROLE_ID=

# Discord guild ID (for slash command registration)
DISCORD_GUILD_ID=

# Bot API client (the bot talks to the backend over HTTP)
BACKEND_API_BASE=http://localhost:3001
# MUST match BOT_API_TOKEN above; sent as the X-Bot-Token header.
BACKEND_API_TOKEN=dev_bot_token_change_me
