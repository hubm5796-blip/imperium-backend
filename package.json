{
  "name": "imperium-backend",
  "version": "1.0.0",
  "description": "ImperiumMC backend API + Discord bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bot": "tsx watch src/bot/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bot": "node dist/bot/index.js",
    "start:all": "concurrently \"npm:start\" \"npm:start:bot\"",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "cookie": "^1.0.1",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "hono": "^4.6.0",
    "jose": "^6.2.7",
    "nanoid": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/cookie": "^1.0.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.118.0"
  }
}
