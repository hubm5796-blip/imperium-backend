{
  "name": "imperium-backend",
  "version": "1.0.0",
  "description": "ImperiumMC backend API + Discord bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bot": "tsx watch src/bot/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bot": "node dist/bot/index.js",
    "start:all": "concurrently \"npm:start\" \"npm:start:bot\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "cookie": "^1.0.1",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
