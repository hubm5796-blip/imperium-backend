{
  "name": "imperium-backend",
  "version": "1.0.0",
  "description": "ImperiumMC backend API + Discord bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "register-commands": "tsx src/bot/registerCommands.ts",
    "register-commands:guild": "tsx src/bot/registerCommands.ts --guild",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.3",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.4.0",
    "cookie": "^1.0.1",
    "discord-api-types": "^0.38.52",
    "discord-interactions": "^4.4.0",
    "dotenv": "^16.4.0",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "nanoid": "^5.0.0",
    "pg": "^8.13.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/cookie": "^1.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "8.9.0"
  },
  "engines": {
    "node": "26.x",
    "npm": ">=10.9.0"
  }
}
